---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo.webp';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import { SITE, waLink } from '../data/site';
import { url } from '../data/url';
import { CATEGORIAS } from '../data/categorias';
const year = new Date().getFullYear();

const colTitle = 'mb-7 text-[0.8rem] font-bold tracking-[0.1em] text-white uppercase';
const linkList = 'flex flex-col gap-3.5';
const linkItem =
  "group flex items-center gap-2 text-sm text-slate-400 transition-all hover:gap-3 hover:text-slate-200 before:text-[0.85rem] before:text-morado before:content-['→']";
const social = 'flex size-8 items-center justify-center rounded-full text-white transition hover:scale-110 hover:opacity-90';

const contacto = [
  { icon: 'pin', label: 'Dirección', text: SITE.address.full, href: SITE.mapsUrl, external: true },
  { icon: 'phone', label: 'Teléfono / WhatsApp', text: SITE.phoneDisplay, href: `tel:${SITE.phone}` },
  { icon: 'mail', label: 'Correo', text: SITE.email, href: `mailto:${SITE.email}` },
] as const;
---

<footer class="border-t border-white/5 bg-tinta px-4 pt-[50px] sm:px-[8%] sm:pt-[70px]">
  <div class="grid grid-cols-1 gap-9 pb-[60px] sm:grid-cols-2 xl:grid-cols-[1.3fr_1fr_1.3fr_1fr] xl:gap-12">
    <div class="sm:col-span-2 xl:col-span-1">
      <a href={url('/')} class="mb-5 inline-flex rounded-xl bg-white px-5 py-3">
        <Image src={logo} alt="IMPLANMED" width={160} height={50} class="block h-10 w-auto" />
      </a>
      <p class="mb-5 text-sm leading-[1.7] text-slate-400">
        Implantes médicos, insumos de pabellón e instrumentación quirúrgica para médicos, clínicas y pacientes en Venezuela.
      </p>
      <span class="mb-6 inline-block rounded-full border border-violet-600/30 bg-violet-600/20 px-4 py-1.5 text-[0.8rem] font-bold tracking-[0.03em] text-morado-rosa">
        RIF: {SITE.rif}
      </span>
      <div class="flex items-center gap-2.5">
        <a href={waLink()} target="_blank" rel="noopener" aria-label="WhatsApp" class:list={[social, 'bg-whatsapp']}><BrandIcon name="whatsapp" size={15} /></a>
        <a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class:list={[social, 'bg-linear-45 from-[#f09433] via-[#dc2743] to-[#bc1888]']}><BrandIcon name="instagram" size={15} /></a>
        <a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class:list={[social, 'bg-facebook']}><BrandIcon name="facebook" size={15} /></a>
      </div>
    </div>

    <div>
      <h2 class={colTitle}>Productos</h2>
      <ul class={linkList}>
        {CATEGORIAS.map((c) => <li><a class={linkItem} href={url(`/productos/categoria/${c.slug}`)}>{c.nombre}</a></li>)}
        <li><a class={linkItem} href={url('/productos')}>Catálogo completo</a></li>
      </ul>
    </div>

    <div>
      <h2 class={colTitle}>Contacto</h2>
      <ul class="flex flex-col gap-6">
        {contacto.map((c) => (
          <li class="flex items-start gap-4">
            <span class="flex size-[38px] shrink-0 items-center justify-center rounded-[10px] border border-white/8 bg-white/5 text-morado-claro">
              <Icon name={c.icon} />
            </span>
            <span>
              <span class="mb-1 block text-[0.72rem] font-bold tracking-[0.06em] text-slate-500 uppercase">{c.label}</span>
              <a
                href={c.href}
                class="text-sm leading-normal text-slate-300 transition-colors hover:text-morado-rosa"
                {...('external' in c ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >{c.text}</a>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class={colTitle}>Empresa y legal</h2>
      <ul class={linkList}>
        <li><a class={linkItem} href={url('/nosotros')}>Nosotros</a></li>
        <li><a class={linkItem} href={url('/servicios')}>Servicios</a></li>
        <li><a class={linkItem} href={url('/blog')}>Blog</a></li>
        <li><a class={linkItem} href={url('/legal/terminos')}>Términos y condiciones</a></li>
        <li><a class={linkItem} href={url('/legal/devoluciones')}>Cambios y devoluciones</a></li>
        <li><a class={linkItem} href={url('/legal/privacidad')}>Privacidad</a></li>
      </ul>
    </div>
  </div>

  <div class="flex flex-col items-center gap-3 border-t border-white/5 py-5 text-center text-[0.8rem] text-slate-600 sm:flex-row sm:justify-between sm:text-left">
    <p>© {year} {SITE.name} Maracaibo, Venezuela.</p>
    <a href={SITE.social.instagram} target="_blank" rel="noopener" class="hover:text-white">{SITE.social.instagramHandle}</a>
  </div>
</footer>
