---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { BLOG_CATEGORIAS, formatDate } from '../data/blog';
import { url } from '../data/url';
interface Props { post: CollectionEntry<'blog'>; featured?: boolean }
const { post, featured = false } = Astro.props;
const cat = BLOG_CATEGORIAS[post.data.category];
const href = url(`/blog/${post.id}`);
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-2xl border-2 border-transparent bg-white shadow-[0_2px_12px_rgb(0_0_0/0.06)] transition duration-200 hover:-translate-y-1 hover:border-morado hover:shadow-[0_12px_32px_rgb(123_45_139/0.12)]',
    featured && 'lg:row-span-3',
  ]}
>
  <div class:list={['relative shrink-0 overflow-hidden', featured ? 'h-[220px] lg:h-auto lg:min-h-[260px] lg:flex-1' : 'h-[180px] sm:h-[200px]']}>
    <Image src={post.data.image} alt={post.data.imageAlt} width={featured ? 720 : 520} class="size-full object-cover transition-transform duration-400 group-hover:scale-105" />
    <span class:list={['absolute top-3.5 left-3.5 rounded-full px-3.5 py-1 text-[0.72rem] font-bold tracking-[0.5px] text-white uppercase', cat.class]}>{cat.label}</span>
  </div>
  <div class:list={['flex flex-col gap-2', featured ? 'p-6' : 'px-[22px] py-5']}>
    <time class="text-[0.78rem] text-slate-400" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <h3 class:list={['leading-[1.4] font-bold text-slate-900 transition-colors group-hover:text-morado', featured ? 'text-xl' : 'text-base']}>
      <a href={href} class="stretched-link">{post.data.title}</a>
    </h3>
    <p class="text-[0.85rem] leading-[1.65] text-slate-500">{post.data.description}</p>
    <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3.5">
      <span class="text-[0.78rem] font-semibold text-slate-400">{post.data.author}</span>
      <span aria-hidden="true" class="text-[0.82rem] font-bold text-morado">Leer</span>
    </div>
  </div>
</article>
