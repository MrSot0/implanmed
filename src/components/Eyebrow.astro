---
// Rótulo pequeño en mayúsculas con una línea morada a la izquierda (o a ambos lados).
interface Props { both?: boolean; class?: string; tone?: 'morado' | 'azul' }
const { both = false, class: cls, tone = 'morado' } = Astro.props;
---

<span
  class:list={[
    "relative inline-block pl-6 text-[0.85rem] font-bold tracking-[0.08em] uppercase before:absolute before:top-1/2 before:left-0 before:h-0.5 before:w-4 before:-translate-y-1/2 before:bg-current before:content-['']",
    both && "pr-6 after:absolute after:top-1/2 after:right-0 after:h-0.5 after:w-4 after:-translate-y-1/2 after:bg-current after:content-['']",
    tone === 'morado' ? 'text-morado-claro' : 'text-azul',
    cls,
  ]}><slot /></span
>
