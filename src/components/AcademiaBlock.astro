---
import Icon from './Icon.astro';
import { TONOS, type Tono } from '../data/tonos';
const programas: { tono: Tono; icon: 'cap' | 'users' | 'mic' | 'award'; color: string; tag: string; titulo: string; texto: string }[] = [
  { tono: 'azul', icon: 'cap', color: '#4A8FA0', tag: 'TRIMESTRAL', titulo: 'Talleres de técnica quirúrgica', texto: 'Talleres prácticos para cirujanos con modelos anatómicos y guías de uso de implantes.' },
  { tono: 'verde', icon: 'users', color: '#5A8A40', tag: 'MENSUAL', titulo: 'Discusión de casos clínicos', texto: 'Revisión de casos complejos con equipos quirúrgicos de clínicas de la región zuliana.' },
  { tono: 'coral', icon: 'mic', color: '#C87060', tag: 'SEMESTRAL', titulo: 'Charlas con cirujanos invitados', texto: 'Cirujanos de Venezuela y del exterior presentan técnicas de fijación e implantología.' },
  { tono: 'amarillo', icon: 'award', color: '#A0A030', tag: 'CONTINUO', titulo: 'Aval académico', texto: 'Actividades con aval de sociedades médicas nacionales y horas de educación médica continua.' },
];
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
  {
    programas.map((p) => {
      const t = TONOS[p.tono];
      return (
        <div class:list={['flex flex-col items-center rounded-2xl border border-t-[5px] border-slate-200 bg-white px-6 py-8 text-center text-slate-900 transition duration-300 hover:-translate-y-1.5 hover:shadow-[0_16px_32px_-12px_rgb(15_23_42/0.08)]', t.program]}>
          <div class:list={['mb-6 flex size-12 items-center justify-center rounded-xl', t.soft]}>
            <Icon name={p.icon} size={24} stroke={p.color} />
          </div>
          <span class:list={['mb-3 text-xs font-bold tracking-[0.05em]', t.bright]}>{p.tag}</span>
          <h3 class="mb-3 text-[1.2rem] leading-[1.3] font-bold">{p.titulo}</h3>
          <p class="text-[0.85rem] leading-relaxed text-slate-500">{p.texto}</p>
        </div>
      );
    })
  }
</div>
