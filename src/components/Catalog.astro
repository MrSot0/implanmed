---
import type { CollectionEntry } from 'astro:content';
import ProductCard from './ProductCard.astro';
import Icon from './Icon.astro';
import { CATEGORIAS } from '../data/categorias';
import { url } from '../data/url';
import { TONOS } from '../data/tonos';
import { form } from '../data/ui';

const chip =
  'rounded-full border border-slate-200 bg-white px-4 py-2 text-[0.85rem] font-semibold text-slate-700 transition-colors aria-[current=page]:border-morado aria-[current=page]:bg-morado aria-[current=page]:text-white';
interface Props { products: CollectionEntry<'productos'>[]; active?: string }
const { products, active } = Astro.props;
---

<div data-catalog class="text-slate-900">
  <div class="mb-5 flex flex-wrap items-center gap-4">
    <div class="flex flex-[1_1_320px] items-center gap-2.5 rounded-xl border border-slate-200 bg-white px-3.5 text-slate-500 focus-within:border-morado">
      <Icon name="search" size={18} />
      <label class="sr-only" for="buscar">Buscar productos</label>
      <input id="buscar" type="search" placeholder="Buscar por nombre, marca o uso" autocomplete="off" data-search class="w-full bg-transparent py-3.5 text-[0.95rem] text-slate-900 outline-none" />
    </div>
    <label class="flex items-center gap-2 text-[0.85rem] font-semibold text-slate-500">
      <span>Ordenar</span>
      <select data-sort class:list={[form.input, 'select-arrow w-auto']}>
        <option value="order">Recomendados</option>
        <option value="az">Nombre A-Z</option>
        <option value="za">Nombre Z-A</option>
      </select>
    </label>
  </div>

  <nav aria-label="Categorías" class="mb-5 flex flex-wrap gap-2">
    <a href={url('/productos')} aria-current={!active ? 'page' : undefined} class:list={[chip, 'hover:border-morado']}>Todos</a>
    {CATEGORIAS.map((c) => (
      <a href={url(`/productos/categoria/${c.slug}`)} aria-current={active === c.slug ? 'page' : undefined} class:list={[chip, TONOS[c.tono].chip]}>
        {c.nombre}
      </a>
    ))}
  </nav>

  <p aria-live="polite" data-count class="mb-4 text-[0.85rem] text-slate-500">{products.length} productos</p>
  <div data-grid class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4 lg:gap-6">
    {products.map((p) => <ProductCard product={p} />)}
  </div>
  <p data-empty hidden class="rounded-2xl border border-dashed border-slate-200 bg-white p-8 text-center text-slate-500">
    No encontramos productos con esa búsqueda. Escríbenos y lo buscamos por ti: muchos implantes se consiguen bajo pedido.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-search]')!;
    const sort = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-product]')];
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

    const params = new URLSearchParams(location.search);
    input.value = params.get('q') ?? '';

    const apply = () => {
      const terms = norm(input.value.trim()).split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const c of cards) {
        const hay = norm(c.dataset.search ?? '');
        const show = terms.every((t) => hay.includes(t));
        c.hidden = !show;
        if (show) visible++;
      }
      const mode = sort.value;
      const sorted = [...cards].sort((a, b) =>
        mode === 'order'
          ? Number(a.dataset.order) - Number(b.dataset.order)
          : (mode === 'az' ? 1 : -1) * (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '', 'es'),
      );
      sorted.forEach((c) => grid.appendChild(c));
      count.textContent = `${visible} ${visible === 1 ? 'producto' : 'productos'}`;
      empty.hidden = visible > 0;
      const u = new URL(location.href);
      if (input.value.trim()) u.searchParams.set('q', input.value.trim());
      else u.searchParams.delete('q');
      history.replaceState(null, '', u);
    };
    input.addEventListener('input', apply);
    sort.addEventListener('change', apply);
    apply();
  });
</script>
