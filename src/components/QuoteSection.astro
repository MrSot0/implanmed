---
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';
import { waLink } from '../data/site';
import { url } from '../data/url';
import Eyebrow from './Eyebrow.astro';
import { TONOS, type Tono } from '../data/tonos';
import { btn, form, link } from '../data/ui';
interface Props { heading?: 'h1' | 'h2' }
const { heading: H = 'h2' } = Astro.props;
const items: { tono: Tono; label: string; valor: string }[] = [
  { tono: 'coral', label: 'Respuesta', valor: 'Menos de 2 horas hábiles' },
  { tono: 'verde', label: 'Atendemos a', valor: 'Médicos, instituciones y pacientes' },
  { tono: 'azul', label: 'Documentación', valor: 'Presupuesto formal con códigos de seguro' },
];
---

<section id="contacto" class="flex w-full flex-col items-stretch gap-[50px] bg-white px-[5%] py-[60px] text-slate-900 sm:px-[8%] sm:py-[100px] lg:flex-row lg:items-start lg:gap-20">
  <div class="flex-1 lg:max-w-[480px]">
    <Eyebrow>Solicitar presupuesto</Eyebrow>
    <H class="mt-5 mb-5 text-[1.8rem] leading-[1.15] font-extrabold tracking-[-0.02em] sm:text-[2.2rem] lg:text-[2.8rem]">Cuéntanos qué cirugía necesitas cubrir</H>
    <p class="mb-8 leading-[1.7] text-slate-600">
      Envíanos el requerimiento y te respondemos con un presupuesto formal. Si ya sabes qué productos necesitas,
      agrégalos a tu <a href={url('/carrito')} class={link}>solicitud de pedido</a> desde el catálogo.
    </p>

    <a href={waLink()} target="_blank" rel="noopener" class:list={[btn.whatsapp, 'mb-10']}>
      <BrandIcon name="whatsapp" size={20} /> Escribir por WhatsApp
    </a>

    <dl class="flex flex-col gap-3.5">
      {items.map((it) => (
        <div class:list={['flex flex-col-reverse gap-1 rounded-[10px] border-l-4 bg-slate-50 px-5 py-4', TONOS[it.tono].borderL]}>
          <dd class="text-[0.95rem] font-bold">{it.valor}</dd>
          <dt class:list={['text-[0.78rem] font-bold tracking-[0.03em] uppercase', TONOS[it.tono].text]}>{it.label}</dt>
        </div>
      ))}
    </dl>
  </div>

  <div class="flex-1">
    <div class={form.card}>
      <h3 class={form.title}>Formulario de presupuesto</h3>
      <form id="form-presupuesto" novalidate class="flex flex-col gap-5">
        <div class={form.row}>
          <div class={form.field}>
            <label for="q-nombre" class={form.label}>Nombre completo <span class="text-red-500">*</span></label>
            <input type="text" id="q-nombre" name="nombre" autocomplete="name" placeholder="Dr. Juan Pérez" required class={form.input} />
          </div>
          <div class={form.field}>
            <label for="q-telefono" class={form.label}>Teléfono / WhatsApp <span class="text-red-500">*</span></label>
            <input type="tel" id="q-telefono" name="telefono" autocomplete="tel" placeholder="+58 424 000 0000" required pattern="[+0-9 ()-]{7,}" class={form.input} />
          </div>
        </div>
        <div class={form.field}>
          <label for="q-correo" class={form.label}>Correo electrónico <span class="text-red-500">*</span></label>
          <input type="email" id="q-correo" name="correo" autocomplete="email" placeholder="correo@ejemplo.com" required class={form.input} />
        </div>
        <div class={form.row}>
          <div class={form.field}>
            <label for="q-perfil" class={form.label}>Soy <span class="text-red-500">*</span></label>
            <select id="q-perfil" name="perfil" required class:list={[form.input, 'select-arrow']}>
              <option value="">Seleccione una opción</option>
              <option>Médico / Cirujano</option>
              <option>Institución de salud</option>
              <option>Paciente</option>
              <option>Otro</option>
            </select>
          </div>
          <div class={form.field}>
            <label for="q-fecha" class={form.label}>Fecha de cirugía</label>
            <input type="date" id="q-fecha" name="fecha" class={form.input} />
          </div>
        </div>
        <div class={form.field}>
          <label for="q-detalle" class={form.label}>Requerimiento <span class="text-red-500">*</span></label>
          <textarea id="q-detalle" name="detalle" rows="5" required minlength="10" class:list={[form.input, 'min-h-[120px] resize-y']}
            placeholder="Tipo de implante, cantidad, cirujano tratante, seguro o cualquier especificación técnica."></textarea>
        </div>
        <p data-form-error hidden class={form.error}></p>
        <button type="submit" class={btn.submit}>
          <Icon name="send" size={18} /> ENVIAR POR WHATSAPP
        </button>
        <p class={form.disclaimer}>Se abrirá WhatsApp con tu solicitud escrita. No guardamos estos datos en el sitio.</p>
      </form>
    </div>
  </div>
</section>

<script>
  import { SITE } from '../data/site';
  import { validateForm } from '../scripts/forms';

  const form = document.getElementById('form-presupuesto') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validateForm(form)) return;
    const f = new FormData(form);
    const lines = [
      '*Solicitud de presupuesto - IMPLANMED*',
      '',
      `*Nombre:* ${f.get('nombre')}`,
      `*Teléfono:* ${f.get('telefono')}`,
      `*Correo:* ${f.get('correo')}`,
      `*Perfil:* ${f.get('perfil')}`,
      f.get('fecha') ? `*Fecha de cirugía:* ${f.get('fecha')}` : '',
      '',
      '*Requerimiento:*',
      String(f.get('detalle')),
    ].filter((l, i, a) => l !== '' || a[i - 1] !== '');
    window.open(`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });
</script>
