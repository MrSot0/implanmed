---
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';
import { waLink } from '../data/site';
import { url } from '../data/url';
interface Props { heading?: 'h1' | 'h2' }
const { heading: H = 'h2' } = Astro.props;
---

<section id="contacto" class="presupuesto-seccion">
  <div class="presupuesto-info">
    <span class="presupuesto-subtitulo">SOLICITAR PRESUPUESTO</span>
    <H class="presupuesto-titulo">Cuéntanos qué cirugía necesitas cubrir</H>
    <p class="presupuesto-descripcion">
      Envíanos el requerimiento y te respondemos con un presupuesto formal. Si ya sabes qué productos necesitas,
      agrégalos a tu <a href={url('/carrito')} class="link-morado">solicitud de pedido</a> desde el catálogo.
    </p>

    <a href={waLink()} target="_blank" rel="noopener" class="btn-whatsapp-cta">
      <BrandIcon name="whatsapp" size={20} /> Escribir por WhatsApp
    </a>

    <div class="presupuesto-items">
      <div class="pres-item borde-coral"><span class="pres-item-label label-coral">Respuesta</span><span class="pres-item-valor">Menos de 2 horas hábiles</span></div>
      <div class="pres-item borde-verde"><span class="pres-item-label label-verde">Atendemos a</span><span class="pres-item-valor">Médicos, instituciones y pacientes</span></div>
      <div class="pres-item borde-azul"><span class="pres-item-label label-azul">Documentación</span><span class="pres-item-valor">Presupuesto formal con códigos de seguro</span></div>
    </div>
  </div>

  <div class="presupuesto-form-wrapper">
    <div class="presupuesto-form-card">
      <h3 class="form-card-titulo">Formulario de presupuesto</h3>
      <form class="presupuesto-form" id="form-presupuesto" novalidate>
        <div class="form-fila-doble">
          <div class="form-campo">
            <label for="q-nombre">Nombre completo <span class="req">*</span></label>
            <input type="text" id="q-nombre" name="nombre" autocomplete="name" placeholder="Dr. Juan Pérez" required />
          </div>
          <div class="form-campo">
            <label for="q-telefono">Teléfono / WhatsApp <span class="req">*</span></label>
            <input type="tel" id="q-telefono" name="telefono" autocomplete="tel" placeholder="+58 424 000 0000" required pattern="[+0-9 ()-]{7,}" />
          </div>
        </div>
        <div class="form-campo">
          <label for="q-correo">Correo electrónico <span class="req">*</span></label>
          <input type="email" id="q-correo" name="correo" autocomplete="email" placeholder="correo@ejemplo.com" required />
        </div>
        <div class="form-fila-doble">
          <div class="form-campo">
            <label for="q-perfil">Soy <span class="req">*</span></label>
            <select id="q-perfil" name="perfil" required>
              <option value="">Seleccione una opción</option>
              <option>Médico / Cirujano</option>
              <option>Institución de salud</option>
              <option>Paciente</option>
              <option>Otro</option>
            </select>
          </div>
          <div class="form-campo">
            <label for="q-fecha">Fecha de cirugía</label>
            <input type="date" id="q-fecha" name="fecha" />
          </div>
        </div>
        <div class="form-campo">
          <label for="q-detalle">Requerimiento <span class="req">*</span></label>
          <textarea id="q-detalle" name="detalle" rows="5" required minlength="10"
            placeholder="Tipo de implante, cantidad, cirujano tratante, seguro o cualquier especificación técnica."></textarea>
        </div>
        <p class="form-error" data-form-error hidden></p>
        <button type="submit" class="btn-enviar-whatsapp">
          <Icon name="send" size={18} /> ENVIAR POR WHATSAPP
        </button>
        <p class="form-disclaimer">Se abrirá WhatsApp con tu solicitud escrita. No guardamos estos datos en el sitio.</p>
      </form>
    </div>
  </div>
</section>

<script>
  import { SITE } from '../data/site';
  import { validateForm } from '../scripts/forms';

  const form = document.getElementById('form-presupuesto') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validateForm(form)) return;
    const f = new FormData(form);
    const lines = [
      '*Solicitud de presupuesto - IMPLANMED*',
      '',
      `*Nombre:* ${f.get('nombre')}`,
      `*Teléfono:* ${f.get('telefono')}`,
      `*Correo:* ${f.get('correo')}`,
      `*Perfil:* ${f.get('perfil')}`,
      f.get('fecha') ? `*Fecha de cirugía:* ${f.get('fecha')}` : '',
      '',
      '*Requerimiento:*',
      String(f.get('detalle')),
    ].filter((l, i, a) => l !== '' || a[i - 1] !== '');
    window.open(`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });
</script>
