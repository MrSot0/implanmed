---
import Eyebrow from './Eyebrow.astro';
import { SITE } from '../data/site';
import { btn } from '../data/ui';
---

<div class="mt-20 flex flex-col items-center gap-6 rounded-[20px] border border-slate-200 bg-white p-6 text-center text-slate-900 md:flex-row md:gap-12 md:p-8 md:text-left">
  <div class="aspect-[4/3] w-full shrink-0 overflow-hidden rounded-[14px] border border-slate-200 md:max-w-[420px] md:flex-1">
    <iframe src={SITE.mapsEmbed} title="Ubicación de IMPLANMED en Maracaibo" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen class="block size-full border-0"></iframe>
  </div>
  <div class="flex-1">
    <Eyebrow>Ubicación</Eyebrow>
    <h3 class="mt-4 mb-3.5 text-[1.8rem] leading-[1.2] font-extrabold tracking-[-0.02em]">Visítanos en Maracaibo</h3>
    <p class="mb-6 leading-relaxed text-slate-500">{SITE.address.full}</p>
    <a href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer" class={btn.medium}>Abrir en Google Maps</a>
  </div>
</div>
