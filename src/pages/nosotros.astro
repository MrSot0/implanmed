---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Metrics from '../components/Metrics.astro';
import AcademiaBlock from '../components/AcademiaBlock.astro';
import MapBlock from '../components/MapBlock.astro';
import equipo from '../assets/img/equipo-stand.jpg';
import evento from '../assets/img/academia-evento.jpg';
import { SITE } from '../data/site';

const intro = 'mb-16 grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-14';
const foto = 'block aspect-[4/3] w-full rounded-[20px] object-cover';
const caption = 'mt-2.5 text-[0.82rem] text-slate-500';
const texto = 'mt-4 text-[1.05rem] leading-relaxed text-slate-500';
---

<BaseLayout title="Nosotros y academia" description="IMPLANMED distribuye implantes médicos en Maracaibo desde hace más de 15 años y organiza actividades de formación para cirujanos.">
  <PageHeader eyebrow="NOSOTROS" title="IMPLANMED en Maracaibo" crumbs={[{ label: 'Nosotros' }]} />

  <section class="bg-slate-50 px-4 py-[100px] text-slate-900 sm:px-[8%]">
    <div class={intro}>
      <SectionIntro eyebrow="Quiénes somos" title="Implantes, insumos y soporte en pabellón">
        <p class={texto}>
          {SITE.legalName} distribuye implantes de columna, traumatología y cirugía maxilofacial, además de insumos
          para pabellón. Trabajamos con cirujanos, clínicas y pacientes del Zulia y del resto de Venezuela.
        </p>
        <p class="mt-3 text-[1.05rem] leading-relaxed text-slate-500">
          Nuestros instrumentistas acompañan las cirugías y preparamos la documentación que piden las aseguradoras para
          aprobar cada caso.
        </p>
      </SectionIntro>
      <figure>
        <Image src={equipo} alt="Equipo de IMPLANMED en su stand junto a modelos de columna y el sistema ZEUS" width={640} class={foto} />
        <figcaption class={caption}>Equipo de IMPLANMED con el sistema de tornillos pediculares ZEUS.</figcaption>
      </figure>
    </div>
    <Metrics />
  </section>

  <section class="bg-white px-4 py-[100px] text-slate-900 sm:px-[8%]">
    <div class={intro}>
      <figure class="order-2 lg:order-none">
        <Image src={evento} alt="Cirujanos y residentes en una jornada académica organizada por IMPLANMED" width={640} class={foto} />
        <figcaption class={caption}>Jornada académica con cirujanos y residentes en Maracaibo.</figcaption>
      </figure>
      <SectionIntro
        eyebrow="Academia"
        title="Formación para cirujanos"
        text="Organizamos y copatrocinamos actividades para especialistas y residentes: talleres con modelos anatómicos, discusión de casos y charlas con cirujanos invitados."
      />
    </div>
    <AcademiaBlock />
    <MapBlock />
  </section>
</BaseLayout>
