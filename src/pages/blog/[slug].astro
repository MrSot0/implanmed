---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BlogCard from '../../components/BlogCard.astro';
import BrandIcon from '../../components/BrandIcon.astro';
import { getPosts, BLOG_CATEGORIAS, formatDate } from '../../data/blog';
import { SITE, waLink } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const { Content } = await render(post);
const cat = BLOG_CATEGORIAS[post.data.category];
const otros = posts.filter((p) => p.id !== post.id).slice(0, 3);
const og = await getImage({ src: post.data.image, width: 1200, format: 'jpg' });
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(og.src, Astro.site).href,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: SITE.name },
};
---

<BaseLayout title={post.data.title} description={post.data.description} image={og.src} type="article" jsonLd={ld}>
  <PageHeader eyebrow={cat.label.toUpperCase()} title={post.data.title} crumbs={[{ label: 'Blog', href: '/blog' }, { label: post.data.title }]}>
    <p class="articulo-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time> · {post.data.author}
    </p>
  </PageHeader>

  <article class="articulo">
    <Image src={post.data.image} alt={post.data.imageAlt} width={960} class="articulo-portada" loading="eager" />
    <div class="prose">
      <Content />
    </div>
    <aside class="articulo-cta">
      <p>¿Tienes una cirugía programada o dudas sobre un implante?</p>
      <a class="btn-whatsapp-cta" href={waLink(`Hola, leí el artículo "${post.data.title}" y tengo una consulta.`)} target="_blank" rel="noopener">
        <BrandIcon name="whatsapp" size={20} /> Escribir por WhatsApp
      </a>
    </aside>
  </article>

  {otros.length > 0 && (
    <section class="blog-seccion">
      <div class="blog-header"><div><span class="subtitulo-seccion">SEGUIR LEYENDO</span><h2 class="titulo-seccion">Otros artículos</h2></div></div>
      <div class="blog-grid blog-grid-lista">{otros.map((p) => <BlogCard post={p} />)}</div>
    </section>
  )}
</BaseLayout>
