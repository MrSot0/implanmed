---
// Panel del CMS (Sveltia CMS, compatible con la configuración de Decap CMS).
// La configuración vive en public/admin/config.yml.
const config = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/admin/config.yml`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Administración | IMPLANMED</title>
    <link href={config} type="application/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script is:inline src="https://unpkg.com/@sveltia/cms@0.263.0/dist/sveltia-cms.js"></script>
  </body>
</html>
