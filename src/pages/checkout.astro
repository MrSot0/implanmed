---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { url } from '../data/url';
import { btn, form, link } from '../data/ui';
---

<BaseLayout title="Enviar solicitud" noindex>
  <PageHeader eyebrow="PEDIDO" title="Datos para el presupuesto" crumbs={[{ label: 'Mi solicitud', href: '/carrito' }, { label: 'Enviar' }]} />

  <section class="grid grid-cols-1 items-start gap-8 bg-slate-50 px-4 pt-12 pb-24 text-slate-900 sm:px-[8%] lg:grid-cols-[minmax(0,1fr)_340px]">
    <form id="checkout" novalidate class:list={[form.card, 'flex flex-col gap-5']}>
      <fieldset class="flex flex-col gap-[18px]">
        <legend class:list={[form.title, 'mb-[18px]']}>Quién solicita</legend>
        <div class={form.row}>
          <div class={form.field}><label for="c-nombre" class={form.label}>Nombre y apellido <span class="text-red-500">*</span></label><input id="c-nombre" name="Nombre" autocomplete="name" required class={form.input} /></div>
          <div class={form.field}><label for="c-doc" class={form.label}>Cédula o RIF <span class="text-red-500">*</span></label><input id="c-doc" name="Cédula/RIF" required placeholder="V-12345678 / J-12345678-9" class={form.input} /></div>
        </div>
        <div class={form.row}>
          <div class={form.field}><label for="c-tel" class={form.label}>Teléfono / WhatsApp <span class="text-red-500">*</span></label><input id="c-tel" name="Teléfono" type="tel" autocomplete="tel" required pattern="[+0-9 ()-]{7,}" class={form.input} /></div>
          <div class={form.field}><label for="c-mail" class={form.label}>Correo <span class="text-red-500">*</span></label><input id="c-mail" name="Correo" type="email" autocomplete="email" required class={form.input} /></div>
        </div>
        <div class={form.row}>
          <div class={form.field}>
            <label for="c-perfil" class={form.label}>Soy <span class="text-red-500">*</span></label>
            <select id="c-perfil" name="Perfil" required class:list={[form.input, 'select-arrow']}>
              <option value="">Seleccione</option>
              <option>Médico / Cirujano</option>
              <option>Institución de salud</option>
              <option>Paciente o familiar</option>
            </select>
          </div>
          <div class={form.field}><label for="c-inst" class={form.label}>Clínica u hospital</label><input id="c-inst" name="Institución" class={form.input} /></div>
        </div>
      </fieldset>

      <fieldset class="flex flex-col gap-[18px]">
        <legend class:list={[form.title, 'mb-[18px]']}>Cirugía</legend>
        <div class={form.row}>
          <div class={form.field}><label for="c-medico" class={form.label}>Cirujano tratante</label><input id="c-medico" name="Cirujano" class={form.input} /></div>
          <div class={form.field}><label for="c-fecha" class={form.label}>Fecha tentativa</label><input id="c-fecha" name="Fecha de cirugía" type="date" class={form.input} /></div>
        </div>
        <div class={form.field}><label for="c-seguro" class={form.label}>Seguro o forma de cobertura</label><input id="c-seguro" name="Seguro" placeholder="Nombre de la aseguradora, o particular" class={form.input} /></div>
      </fieldset>

      <fieldset class="flex flex-col gap-[18px]">
        <legend class:list={[form.title, 'mb-[18px]']}>Entrega y pago</legend>
        <div class={form.row}>
          <div class={form.field}>
            <label for="c-entrega" class={form.label}>Entrega <span class="text-red-500">*</span></label>
            <select id="c-entrega" name="Entrega" required class:list={[form.input, 'select-arrow']}>
              <option value="">Seleccione</option>
              <option>Entrega en la clínica (Maracaibo)</option>
              <option>Retiro en tienda</option>
              <option>Envío a otra ciudad</option>
            </select>
          </div>
          <div class={form.field}><label for="c-ciudad" class={form.label}>Ciudad</label><input id="c-ciudad" name="Ciudad" value="Maracaibo" class={form.input} /></div>
        </div>
        <div class={form.field}>
          <label for="c-pago" class={form.label}>Forma de pago preferida <span class="text-red-500">*</span></label>
          <select id="c-pago" name="Pago" required class:list={[form.input, 'select-arrow']}>
            <option value="">Seleccione</option>
            <option>Carta aval / seguro</option>
            <option>Transferencia en bolívares</option>
            <option>Pago móvil</option>
            <option>Divisas en efectivo</option>
            <option>Zelle</option>
          </select>
        </div>
        <div class={form.field}><label for="c-notas" class={form.label}>Notas</label><textarea class={form.input} id="c-notas" name="Notas" rows="3" placeholder="Medidas, niveles, instrucciones de entrega..."></textarea></div>
      </fieldset>

      <label class="flex items-start gap-2.5 text-[0.88rem] leading-normal text-slate-700">
        <input type="checkbox" required id="c-acepto" class="mt-0.5 size-4 flex-none accent-morado" />
        <span>Acepto los <a class={link} href={url('/legal/terminos')} target="_blank">términos</a> y la <a class={link} href={url('/legal/privacidad')} target="_blank">política de privacidad</a>.</span>
      </label>
      <p data-form-error hidden class={form.error}></p>
      <button type="submit" class={btn.submit}><Icon name="send" size={18} /> ENVIAR SOLICITUD POR WHATSAPP</button>
      <p class={form.disclaimer}>No se realiza ningún cobro en el sitio. Un asesor confirma precios, disponibilidad y forma de pago.</p>
    </form>

    <aside class="flex flex-col gap-4 rounded-[20px] border border-slate-200 bg-white p-7 lg:sticky lg:top-[calc(var(--spacing-nav)+24px)]">
      <h2 class="text-[1.4rem] font-bold">Tu solicitud</h2>
      <ul data-items class="flex flex-col gap-2.5 text-[0.9rem] [&>li]:flex [&>li]:flex-col [&>li]:gap-0.5 [&>li]:border-b [&>li]:border-slate-100 [&>li]:pb-2.5 [&_span]:text-[0.82rem] [&_span]:text-slate-500"></ul>
      <a class={link} href={url('/carrito')}>Editar</a>
    </aside>
  </section>
</BaseLayout>

<script>
  import { getCart, clearCart, newOrderCode, orderMessage, saveOrder, variantLabel } from '../scripts/cart';
  import { validateForm } from '../scripts/forms';
  import { SITE } from '../data/site';
  import { url } from '../data/url';

  const items = getCart();
  if (items.length === 0) location.replace(url('/carrito'));

  const ul = document.querySelector<HTMLElement>('[data-items]')!;
  for (const i of items) {
    const li = document.createElement('li');
    const strong = document.createElement('strong');
    strong.textContent = `${i.qty} × ${i.title}`;
    li.appendChild(strong);
    const v = variantLabel(i.variant);
    if (v) {
      const s = document.createElement('span');
      s.textContent = v;
      li.appendChild(s);
    }
    ul.appendChild(li);
  }

  const form = document.getElementById('checkout') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validateForm(form)) return;
    const customer: Record<string, string> = {};
    for (const [k, v] of new FormData(form)) if (String(v).trim()) customer[k] = String(v).trim();

    const code = newOrderCode();
    const order = { code, createdAt: new Date().toISOString(), items, customer };
    saveOrder(order);
    const wa = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(orderMessage(order))}`;
    window.open(wa, '_blank', 'noopener');
    clearCart();
    location.href = `${url('/pedido')}?codigo=${encodeURIComponent(code)}`;
  });
</script>
