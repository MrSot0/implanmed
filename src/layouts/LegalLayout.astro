---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <PageHeader eyebrow="LEGAL" title={frontmatter.title} crumbs={[{ label: frontmatter.title }]}>
    <p class="articulo-meta">Última actualización: {frontmatter.updated}</p>
  </PageHeader>
  <article class="articulo"><div class="prose"><slot /></div></article>
</BaseLayout>
